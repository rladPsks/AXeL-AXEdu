__pycache__/
*.py[cod]
.venv/
venv/
.env
.env.*
!.env.example
.streamlit/secrets.toml
*.db
*.sqlite
*.sqlite3
*.log
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.DS_Store
Thumbs.db
.vscode/
.idea/
build/
dist/
*.egg-info/

# 원본 학교 문서와 파싱 산출물은 개인정보·저작권·내부자료 보호를 위해 로컬에만 보관
documents/raw/*
!documents/raw/.gitkeep
documents/parsed/*
!documents/parsed/.gitkeep
documents/chunks/*
!documents/chunks/.gitkeep

# Human-in-the-Loop 검수 기록·수정본은 로컬에서 관리하고 원본 저장소에 커밋하지 않음
documents/review/*
!documents/review/.gitkeep

# Local parser/review backups
documents/chunks_backup_*/
documents/parsed_backup_*/
documents/review_backup_*/
