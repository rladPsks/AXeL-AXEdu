{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "python -m pip install -r requirements.txt"
  },
  "deploy": {
    "startCommand": "uvicorn backend.main:create_app --factory --host 0.0.0.0 --port $PORT",
    "healthcheckPath": "/api/health",
    "numReplicas": 1
  }
}
