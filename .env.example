# Local defaults. Railway: /data/app.sqlite3 (mount a persistent volume at /data).
SCHOOL_AGENT_DB=data/private/dev.sqlite3
# Railway: 1. Keep 0 if using python -m backend.worker separately.
SCHOOL_AGENT_RUN_WORKER=0
# Set secrets only in the backend environment, never in frontend VITE_* variables.
OPENAI_API_KEY=
OPENAI_MODEL=
