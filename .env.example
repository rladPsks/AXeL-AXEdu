# ============================================================
# 백엔드 환경변수 견본. 복사해서 `.env`를 만들고 값을 채우세요.
#   Copy-Item .env.example .env
# `.env`는 .gitignore 대상이라 GitHub에 올라가지 않습니다.
# 이미 설정된 실제 환경변수($env:, Render 대시보드)가 항상 .env보다 우선합니다.
# ============================================================

# --- 기본 실행 ---------------------------------------------
SCHOOL_AGENT_DB=data/private/dev.sqlite3
# 서버 안에서 알림·AI·전사 작업 스레드를 함께 실행 (로컬 단일 프로세스는 1 권장)
SCHOOL_AGENT_RUN_WORKER=1

# --- 공개 시연 전용 (가상 데이터에만 사용) ------------------
# 1이면 서버 시작 시 빈 DB에 가상 사건·계정을 자동 생성하고 계정 버튼 로그인을 허용합니다.
# 실제 학교 데이터와 함께 켜지 마세요.
SCHOOL_AGENT_AUTO_SEED=0
SCHOOL_AGENT_DEMO=0

# --- OpenAI (AI 지원 검토·사건 비교·발화 요약) ---------------
# 비밀값: 프런트(VITE_*)에는 절대 넣지 않습니다.
OPENAI_API_KEY=
OPENAI_MODEL=

# --- Azure AI Speech (동의 녹취 전사) ------------------------
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=koreacentral
# 리전 대신 https 엔드포인트를 직접 지정할 때:
# AZURE_SPEECH_ENDPOINT=https://koreacentral.api.cognitive.microsoft.com
# AZURE_SPEECH_LOCALE=ko-KR
# AZURE_SPEECH_API_VERSION=2024-11-15
# AZURE_SPEECH_DIARIZATION=1
