# Local defaults. Render demo: data/private/demo.sqlite3 (ephemeral).
SCHOOL_AGENT_DB=data/private/dev.sqlite3
# Render demo: 1. Keep 0 if using python -m backend.worker separately.
SCHOOL_AGENT_RUN_WORKER=0
# Enable only for a public fictional demonstration; never use with real school data.
SCHOOL_AGENT_AUTO_SEED=0
SCHOOL_AGENT_DEMO=0
# Set secrets only in the backend environment, never in frontend VITE_* variables.
OPENAI_API_KEY=
OPENAI_MODEL=

# Azure AI Speech (동의 녹취 전사)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=koreacentral
# AZURE_SPEECH_ENDPOINT=https://koreacentral.api.cognitive.microsoft.com
# AZURE_SPEECH_LOCALE=ko-KR
